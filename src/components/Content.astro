---
const proyectos = [
  {
    nombre: "Cromoverse",
    tipo: "SaaS multi-tenant",
    descripcion:
      "Plataforma de coleccionismo digital gamificado. Cromos únicos por usuario, sistema de sobres, intercambios y temas por tenant. Piloto: fiestas de Moros y Cristianos.",
    stack: ["Next.js 16", "Supabase", "TypeScript", "Framer Motion"],
    url: "#",
  },
  {
    nombre: "mkgenia",
    tipo: "Web de agencia",
    descripcion:
      "Web para una agencia de automatización con IA enfocada al sector inmobiliario. Animaciones fluidas, modo oscuro y demo de dashboard interactivo.",
    stack: ["Next.js 14", "Tailwind CSS", "Framer Motion"],
    url: "#",
  },
  {
    nombre: "CRM Inmobiliario",
    tipo: "Aplicación interna",
    descripcion:
      "CRM a medida con autenticación, roles y permisos por módulo (leads, captaciones, campañas, mensajes). Construido desde cero para máxima mantenibilidad.",
    stack: ["Next.js 15", "shadcn/ui", "Supabase"],
    url: "#",
  },
];

const stack = [
  "TypeScript",
  "Next.js",
  "Astro",
  "React",
  "Tailwind CSS",
  "Supabase",
  "PostgreSQL",
  "Framer Motion",
  "PHP",
  "WordPress",
];
---

<!-- Sobre mí -->
<section id="sobre-mi" class="max-w-3xl mx-auto px-4 py-24 scroll-mt-20">
  <p class="font-pixel text-sm uppercase tracking-widest text-white/50 mb-4">// Sobre mí</p>
  <h2 class="font-pixel text-3xl sm:text-4xl leading-tight mb-6 text-glow">
    Desarrollador web centrado en construir productos rápidos y bien hechos.
  </h2>
  <p class="text-lg text-white/70 leading-relaxed">
    Diseño y programo aplicaciones web modernas de principio a fin: desde la interfaz
    hasta la base de datos. Trabajo sobre todo con el ecosistema de React (Next.js,
    Astro) y Supabase, y tengo amplia experiencia en PHP y WordPress — desde temas y
    plugins a medida hasta webs corporativas completas. Siempre cuidando el
    rendimiento, la experiencia de usuario y el código mantenible.
  </p>
</section>

<hr class="dither max-w-6xl mx-auto" />

<!-- Proyectos -->
<section id="proyectos" class="scroll-mt-20">
  <div class="max-w-6xl mx-auto px-4 py-24">
    <p class="font-pixel text-sm uppercase tracking-widest text-white/50 mb-4">// Proyectos</p>
    <h2 class="font-pixel text-3xl sm:text-4xl mb-12 text-glow">Algunos trabajos recientes</h2>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        proyectos.map((p) => (
          <article class="pixel-card flex flex-col p-6">
            <p class="font-pixel text-xs uppercase tracking-wider text-white/45 mb-2">
              {p.tipo}
            </p>
            <h3 class="font-pixel text-xl mb-3">{p.nombre}</h3>
            <p class="text-white/70 leading-relaxed flex-1">{p.descripcion}</p>
            <ul class="flex flex-wrap gap-2 mt-5">
              {p.stack.map((s) => (
                <li class="pixel-chip text-xs px-3 py-1 text-white/70">{s}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<hr class="dither max-w-6xl mx-auto" />

<!-- Stack -->
<section id="stack" class="max-w-6xl mx-auto px-4 py-24 scroll-mt-20">
  <p class="font-pixel text-sm uppercase tracking-widest text-white/50 mb-4">// Stack</p>
  <h2 class="font-pixel text-3xl sm:text-4xl mb-8 text-glow">Herramientas con las que trabajo</h2>
  <ul class="flex flex-wrap gap-3">
    {
      stack.map((s) => (
        <li class="pixel-chip px-4 py-2 text-white/80">{s}</li>
      ))
    }
  </ul>
</section>

<hr class="dither max-w-6xl mx-auto" />

<!-- Contacto -->
<section id="contacto" class="scroll-mt-20">
  <div class="max-w-3xl mx-auto px-4 py-24 text-center">
    <p class="font-pixel text-sm uppercase tracking-widest text-white/50 mb-4">// Contacto</p>
    <h2 class="font-pixel text-3xl sm:text-4xl mb-6 text-glow">¿Hablamos?</h2>
    <p class="text-lg text-white/70 mb-8">
      Estoy abierto a nuevos proyectos y colaboraciones. Escríbeme y te respondo pronto.
    </p>
    <a href="mailto:orriols002@gmail.com" class="pixel-btn font-pixel px-8 py-3">
      orriols002@gmail.com
    </a>
  </div>
</section>
