---
const base = import.meta.env.BASE_URL;
---

<section class="relative z-10 px-4 pt-14 pb-16 sm:pt-20">
  <h1 class="sr-only">
    Josep Ferrer Bañuls — Automation &amp; AI Systems Developer · Web &amp;
    Mobile Development · Valencia, España
  </h1>

  <div class="term max-w-3xl mx-auto">
    <div class="term-bar">
      <span class="term-dot"></span>
      <span class="term-dot"></span>
      <span class="term-dot"></span>
      <span class="ml-2">josep@portfolio: ~</span>
    </div>
    <div id="term-body" class="term-body" aria-live="polite"></div>
    <div class="crt-lines"></div>
  </div>

  <div class="text-center mt-10">
    <a
      href={`${base}#proyectos`}
      class="pixel-btn font-pixel px-7 py-3 text-sm"
    >
      Ver proyectos ↓
    </a>
  </div>
</section>

<script>
  import "../scripts/terminal/index.js";
</script>
